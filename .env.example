# =============================================================
#  FinTrackPro Backend — Environment Configuration
#  Copy this file to .env and run: npm run dev
#  Only MONGODB_URI, JWT_SECRET, JWT_REFRESH_SECRET, COOKIE_SECRET are REQUIRED.
#  Everything else has safe defaults for local development.
# =============================================================

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------
# Database — REQUIRED
# For local dev: make sure MongoDB is running on port 27017
# brew services start mongodb-community   (macOS)
# sudo systemctl start mongod              (Linux)
# Or use MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/fintrackpro
# ---------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/fintrackpro

# ---------------------------------------------------------------
# JWT Secrets — REQUIRED (min 32 characters each)
# ---------------------------------------------------------------
JWT_SECRET=fintrackpro-dev-jwt-secret-key-change-in-prod-32chars
JWT_REFRESH_SECRET=fintrackpro-dev-refresh-secret-change-in-prod-32ch
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------
# Cookie — REQUIRED (min 32 characters)
# ---------------------------------------------------------------
COOKIE_SECRET=fintrackpro-dev-cookie-secret-change-in-prod-32chars

# ---------------------------------------------------------------
# Client URL (frontend)
# ---------------------------------------------------------------
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------
# Cloudinary — OPTIONAL in dev (profile image uploads will be skipped)
# Get free credentials at https://cloudinary.com
# ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------
# Email — OPTIONAL in dev (emails are logged to console instead)
# For Gmail: use an App Password (not your regular password)
# https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@fintrackpro.com

# ---------------------------------------------------------------
# Security (defaults are fine for dev)
# ---------------------------------------------------------------
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
